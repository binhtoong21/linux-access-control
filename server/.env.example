# Dev settings of the server. Copy to .env (git-ignored) and fill in; `pnpm start:dev` reads .env.
# Production uses the same KEY=value format as a systemd EnvironmentFile (11-operations/deployment.md).
# Relative paths are resolved from server/.

# --- Required -------------------------------------------------------------
# Dev PostgreSQL from deploy/dev (PG_PORT=15432 when a local PostgreSQL already uses 5432).
DATABASE_URL=postgres://nfclab:nfclab-dev@127.0.0.1:15432/nfclab
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# UID keys and km-master.key (create once with: KEYS_DIR=../deploy/dev/keys pnpm keys:init).
KEYS_DIR=../deploy/dev/keys
# Dev CA from deploy/dev/gen-dev-certs.sh: signs workstation certificates; the CRL is read by the dev broker.
CA_CERT_FILE=../deploy/dev/certs/ca.crt
CA_KEY_FILE=../deploy/dev/certs/ca/ca.key
CRL_FILE=../deploy/dev/certs/crl.pem

# --- Optional -------------------------------------------------------------
PORT=8000
# Empty = no broker connection (health shows mqtt: "disabled"). Set it to talk to workstations.
MQTT_URL=
# MQTT_URL=mqtts://localhost:8883
MQTT_CA=../deploy/dev/certs/ca.crt
MQTT_CERT=../deploy/dev/certs/nfc-server.crt
MQTT_KEY=../deploy/dev/certs/nfc-server.key
# Broker address handed to an approved workstation: 10.0.2.2 for a VirtualBox NAT guest such as vm2.
BROKER_HOST=localhost
BROKER_PORT=8883
# Run after a certificate revocation so that open connections are cut (empty = only rewrite the CRL).
BROKER_RESTART_CMD=docker restart dev-mosquitto-1
# off = no snapshot worker timers (maintenance).
SNAPSHOT_WORKER=on
