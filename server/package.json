{
  "name": "nfc-lab-server",
  "version": "0.1.0",
  "private": true,
  "description": "Central server: identity, device, scheduling, distribution, operations (ADR-006)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "db:migrate": "pnpm build && node dist/infra/database/migrate-cli.js up",
    "db:rollback": "pnpm build && node dist/infra/database/migrate-cli.js down",
    "db:status": "pnpm build && node dist/infra/database/migrate-cli.js status",
    "admin:create": "pnpm build && node dist/identity/create-admin-cli.js",
    "keys:init": "pnpm build && node dist/shared/crypto/keys-cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.2.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "kysely": "^0.27.6",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "ajv": "^8.17.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test",
      "<rootDir>/src"
    ],
    "testRegex": ".*\\.spec\\.ts$"
  }
}
