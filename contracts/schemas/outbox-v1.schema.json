{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outbox-v1",
  "title": "Outbox batch (Edge → Server)",
  "type": "object",
  "required": [
    "schema",
    "workstation_id",
    "batch_id",
    "from_seq",
    "to_seq",
    "records"
  ],
  "properties": {
    "schema": {
      "const": "outbox-v1"
    },
    "workstation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{3,64}$"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1
    },
    "from_seq": {
      "type": "integer",
      "minimum": 1
    },
    "to_seq": {
      "type": "integer",
      "minimum": 1
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "entry_id",
              "outbox_seq",
              "occurred_at",
              "event_type",
              "payload"
            ],
            "properties": {
              "entry_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "outbox_seq": {
                "type": "integer",
                "minimum": 1
              },
              "occurred_at": {
                "type": "number",
                "minimum": 0
              },
              "event_type": {
                "const": "swipe_decision"
              },
              "payload": {
                "type": "object",
                "required": [
                  "outcome",
                  "reason",
                  "detail",
                  "card_uid",
                  "reader_raw",
                  "user",
                  "card",
                  "target_os_username",
                  "matched_schedule_ids",
                  "data_version"
                ],
                "properties": {
                  "outcome": {
                    "enum": [
                      "granted",
                      "denied",
                      "noop",
                      "error"
                    ]
                  },
                  "reason": {
                    "enum": [
                      "granted",
                      "unknown_card",
                      "card_disabled",
                      "user_inactive",
                      "no_schedule",
                      "out_of_schedule",
                      "data_stale",
                      "workstation_busy",
                      "ambiguous_profile",
                      "profile_disabled",
                      "profile_not_found",
                      "already_active",
                      "invalid_uid",
                      "reader_error",
                      "internal_error"
                    ]
                  },
                  "detail": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "card_uid": {
                    "oneOf": [
                      {
                        "type": "string",
                        "pattern": "^([0-9A-F]{8}|[0-9A-F]{14}|[0-9A-F]{20})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "reader_raw": {
                    "oneOf": [
                      {
                        "type": "string",
                        "maxLength": 128
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "user": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "id",
                          "external_id",
                          "full_name"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                          },
                          "external_id": {
                            "type": "string"
                          },
                          "full_name": {
                            "type": "string"
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "card": {
                    "oneOf": [
                      {
                        "type": "object",
                        "required": [
                          "id",
                          "status"
                        ],
                        "properties": {
                          "id": {
                            "type": "string",
                            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                          },
                          "status": {
                            "enum": [
                              "active",
                              "disabled"
                            ]
                          }
                        }
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "target_os_username": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "matched_schedule_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                    }
                  },
                  "data_version": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "entry_id",
              "outbox_seq",
              "occurred_at",
              "event_type",
              "payload"
            ],
            "properties": {
              "entry_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "outbox_seq": {
                "type": "integer",
                "minimum": 1
              },
              "occurred_at": {
                "type": "number",
                "minimum": 0
              },
              "event_type": {
                "const": "session_started"
              },
              "payload": {
                "type": "object",
                "required": [
                  "session_id",
                  "decision_entry_id",
                  "user_id",
                  "card_id",
                  "os_username",
                  "boot_id",
                  "decided_at",
                  "started_at",
                  "expires_at"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "decision_entry_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "user_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "card_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "os_username": {
                    "type": "string"
                  },
                  "boot_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "decided_at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "started_at": {
                    "type": "number",
                    "minimum": 0
                  },
                  "expires_at": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "entry_id",
              "outbox_seq",
              "occurred_at",
              "event_type",
              "payload"
            ],
            "properties": {
              "entry_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "outbox_seq": {
                "type": "integer",
                "minimum": 1
              },
              "occurred_at": {
                "type": "number",
                "minimum": 0
              },
              "event_type": {
                "const": "session_ended"
              },
              "payload": {
                "type": "object",
                "required": [
                  "session_id",
                  "status",
                  "end_reason",
                  "end_source",
                  "ended_at"
                ],
                "properties": {
                  "session_id": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                  },
                  "status": {
                    "enum": [
                      "completed",
                      "forced_logout",
                      "abandoned"
                    ]
                  },
                  "end_reason": {
                    "enum": [
                      "user_logout",
                      "schedule_expired",
                      "workstation_rebooted",
                      "superseded",
                      "os_session_lost"
                    ]
                  },
                  "end_source": {
                    "enum": [
                      "reported",
                      "reconstructed"
                    ]
                  },
                  "ended_at": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "entry_id",
              "outbox_seq",
              "occurred_at",
              "event_type",
              "payload"
            ],
            "properties": {
              "entry_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
              },
              "outbox_seq": {
                "type": "integer",
                "minimum": 1
              },
              "occurred_at": {
                "type": "number",
                "minimum": 0
              },
              "event_type": {
                "const": "security_alert"
              },
              "payload": {
                "type": "object",
                "required": [
                  "kind",
                  "detail"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "snapshot_signature_invalid",
                      "edge_db_recovered",
                      "key_version_mismatch",
                      "teardown_failed_stuck_resource"
                    ]
                  },
                  "detail": {
                    "oneOf": [
                      {
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
